/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/.env*
  Cache-Control: no-store

/data/*
  Cache-Control: no-store

/backend/*
  Cache-Control: no-store

/app/js/core/config.js
  Cache-Control: no-store, max-age=0

/app/js/core/auth-guard.js
  Cache-Control: no-store, max-age=0

# SONARA SEO — pages privées / compte jamais indexables
/app/pages/creator/*
  X-Robots-Tag: noindex, nofollow
/app/pages/account/*
  X-Robots-Tag: noindex, nofollow
/app/pages/auth/*
  X-Robots-Tag: noindex, nofollow
/app/pages/user/*
  X-Robots-Tag: noindex, nofollow
/app/pages/system/*
  X-Robots-Tag: noindex, nofollow
/app/pages/catalog/library.html
  X-Robots-Tag: noindex, nofollow
/app/pages/catalog/download.html
  X-Robots-Tag: noindex, nofollow
/app/pages/catalog/montage.html
  X-Robots-Tag: noindex, nofollow
/app/pages/catalog/sync-saves.html
  X-Robots-Tag: noindex, nofollow
